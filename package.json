{
  "name": "odd-tools-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "projects/*",
    "packages/*"
  ],
  "scripts": {
    "dev:portal": "npm run dev --workspace @odd-tools/portal",
    "dev:money-world": "npm run dev --workspace @odd-tools/money-world",
    "build": "node tooling/build-all.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:contracts": "node tooling/verify-projects.mjs",
    "verify": "npm run verify:contracts && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.6.3",
    "vite": "^8.2.0"
  }
}
